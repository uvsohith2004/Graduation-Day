{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "https://pbrvits-graduation-day.vercel.app/api/auth/$1"
    },
    {
      "source": "/api-proxy/(.*)",
      "destination": "https://pbrvits-graduation-day.vercel.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
